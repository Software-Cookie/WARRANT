terraform {
  required_version = ">= 1.7.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.20"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # State holds resource metadata (no application secrets are generated by this configuration). Keep it in a
  # versioned, CMEK-encrypted bucket that only the deployer can read:
  #   terraform init -backend-config="bucket=<project>-warrant-tfstate"
  backend "gcs" {
    prefix = "warrant"
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}
