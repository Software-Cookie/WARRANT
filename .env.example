# Keys only. Values are supplied by Secret Manager or Workload Identity at runtime.
# CI fails if any value in this file is non-empty (scripts/check-env-example.sh).

# service wiring
WARRANT_ENV=
WARRANT_REGION=
WARRANT_PEP_PORT=
WARRANT_PEP_TENANTS=
WARRANT_CONTROL_PLANE_URL=
WARRANT_CLASSIFIER_URL=
WARRANT_CONSOLE_URL=
WARRANT_PEP_SERVICE_ACCOUNT=

# data stores (IAM auth, no passwords)
WARRANT_DB_INSTANCE=
WARRANT_DB_NAME=
WARRANT_DB_IAM_USER=
WARRANT_DB_RUNTIME_USER=
WARRANT_DB_MIGRATE=
WARRANT_MIGRATE_ONLY=
WARRANT_REDIS_HOST=
WARRANT_REDIS_PORT=
WARRANT_REDIS_TLS=

# keys (references, never material)
WARRANT_KMS_WARRANT_KEY=
WARRANT_KMS_AUDIT_KEY=
WARRANT_KMS_ENVELOPE_KEY=
WARRANT_JWKS_URL=

# identity
WARRANT_OIDC_AUDIENCE=
WARRANT_OIDC_CLIENT_ID=
WARRANT_OIDC_CLIENT_SECRET=
WARRANT_DEFAULT_TENANT=
WARRANT_PROVISION_FILE=
# public single-VM demo only: demo sign-in needs this code (empty = open)
WARRANT_DEMO_ACCESS_CODE=

# models
WARRANT_CLASSIFIER_BACKEND=
WARRANT_CARD_BACKEND=
WARRANT_GEMMA_ENDPOINT=
WARRANT_GEMMA_MODEL=
WARRANT_GEMINI_PROJECT=
WARRANT_GEMINI_LOCATION=
WARRANT_CLASSIFIER_BATCH_MS=
WARRANT_CLASSIFIER_CONFIDENCE_FLOOR=

# behaviour
WARRANT_FAIL_MODE=
WARRANT_ESCALATION_TTL=
WARRANT_DECISION_CACHE_TTL=
WARRANT_POLICY_STALENESS_ALERT=

# integrations (secret references)
WARRANT_CHAT_WEBHOOK_SECRET=
WARRANT_SLACK_WEBHOOK_SECRET=
WARRANT_SMTP_SECRET=
WARRANT_EMAIL_FROM=
